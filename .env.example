# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings -> API) ---
# Full URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Secret key (sb_secret_...). SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# 32+ random chars (openssl rand -base64 48). SERVER ONLY. Required: signs cart/session tokens
# and encrypts stored credentials. Never rotate casually.
APP_SECRET=
# 24+ random chars. Vercel Cron sends it as "Authorization: Bearer ..." to /api/cron/*.
CRON_SECRET=

# --- Platform ---
# HOSTNAME format (no scheme, port or path; a pasted https://www.x.in/ is reduced to x.in). Stores are served at {slug}.{root}; {root} and
# www.{root} serve the platform. For local dev use "localhost" and open http://acme.localhost:3000
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=localhost
# FULL URL format (https://host, no path). Where the platform app lives: links in emails, OAuth
# callbacks, and its host is ALSO served as the platform. Leave blank locally (defaults from the
# root domain). On Vercel before the real domain is attached: https://your-project.vercel.app
NEXT_PUBLIC_PLATFORM_URL=
# Optional, HOSTNAME format, comma-separated: extra exact hosts that serve the platform app
# (e.g. a second Vercel alias). Exact match only; wildcards are rejected.
# Vercel's own *.vercel.app URLs (VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL)
# are trusted automatically.
PLATFORM_HOST_ALIASES=

# --- Edge (Cloudflare domain-router Worker) ---
# 32+ random chars shared with the Worker to sign forwarded hostnames. Leave blank until the Worker is deployed.
EDGE_SHARED_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# --- Super admin bootstrap (pnpm admin:bootstrap) ---
# Used once to create the platform super admin. Never commit real values; remove the password
# from the environment after the first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# --- Social OAuth apps (platform-level; sellers connect their own accounts) ---
# Leave blank to show "Not configured" for that network. Redirect URI to register with each
# provider: https://{platform root}/api/oauth/{provider}/callback
META_APP_ID=
META_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: social webhooks and Neural Pulse AI (or set them in Admin → Social apps)
META_WEBHOOK_VERIFY_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
